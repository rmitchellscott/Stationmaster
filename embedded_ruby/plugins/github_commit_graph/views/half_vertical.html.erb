<%# the graph is 318x252 in this slot, leaving the upper third for figures %>
<div class="view view--half_vertical">
  <div class="layout layout--col gap--space-between">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge"><%= contributions[:total] %></span>
        <span class="label">Contributions in last year</span>
      </div>
    </div>

    <div class="flex gap--large">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value"><%= stats[:current_streak] %></span>
          <span class="label">Streak</span>
        </div>
      </div>
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value"><%= stats[:max_contributions] %></span>
          <span class="label">Best day</span>
        </div>
      </div>
    </div>

    <div id="github_commit_graph">
      <% contributions[:commits].each do |week_of_commits| %>
        <% week_of_commits['contributionDays'].each do |day| %>
          <span class="day <%= git_commit_grayscale(day['contributionCount']) %>"></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="title_bar">
    <img class="image" onerror="this.remove()" src="<%= Rails.application.credentials.base_url %>/images/plugins/github--render.svg" />
    <span class="title">GitHub</span>
    <span class="instance"><%= instance_name %></span>
  </div>
</div>

<%= render 'plugins/github_commit_graph/common' %>
